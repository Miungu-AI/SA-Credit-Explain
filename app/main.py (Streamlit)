"""
SA-CreditExplain — Streamlit Dashboard.
"""
import streamlit as st
import pandas as pd
import plotly.express as px
import plotly.graph_objects as go
import requests
import json
from pathlib import Path

st.set_page_config(page_title="SA-CreditExplain", layout="wide", page_icon="🏦")

# --- Sidebar navigation ---
PAGES = [
    "Executive Overview",
    "Individual Credit Assessment",
    "Fairness & Bias Dashboard",
    "Model Explainability",
    "Accountability & Audit",
    "Regulatory Governance",
]
page = st.sidebar.selectbox("Navigation", PAGES)

st.sidebar.markdown("---")
st.sidebar.warning(
    "**Prototype Disclaimer**\n"
    "This system uses synthetic data. It does not reproduce actual bank policies. "
    "Compliance statuses are internal assessments, not legal certifications."
)


# =========================================================
# PAGE 1: Executive Overview
# =========================================================
if page == "Executive Overview":
    st.title("🏦 Executive Overview")
    df = pd.read_csv("data/synthetic/sa_credit_synthetic.csv")
    metrics = json.loads((Path("models/metrics.json")).read_text())

    col1, col2, col3, col4 = st.columns(4)
    col1.metric("Total Applications (Synthetic)", f"{len(df):,}")
    col2.metric("Approval Rate (Illustrative)", f"{(df['default'] == 0).mean():.1%}")
    col3.metric("Default Rate", f"{df['default'].mean():.1%}")
    col4.metric("Best Model ROC-AUC (XGBoost)", metrics["xgboost"]["roc_auc"])

    st.subheader("Model Performance Comparison")
    perf_df = pd.DataFrame([
        {"Model": k, "ROC-AUC": v["roc_auc"], "F1": v["f1"], "Accuracy": v["accuracy"]}
        for k, v in metrics.items()
    ])
    fig = px.bar(perf_df.melt(id_vars="Model"), x="Model", y="value", color="variable", barmode="group")
    st.plotly_chart(fig, use_container_width=True)

    st.subheader("Governance Risk Summary")
    gov = get_governance_summary()
    st.json({k: v for k, v in gov.items() if k != "controls"})


# =========================================================
# PAGE 2: Individual Credit Assessment
# =========================================================
elif page == "Individual Credit Assessment":
    st.title("📋 Individual Credit Assessment")
    st.info("Enter illustrative application details. The decision is a prototype threshold, not a bank policy.")

    with st.form("application_form"):
        col1, col2 = st.columns(2)
        with col1:
            income = st.number_input("Monthly Income (ZAR)", min_value=1000, value=25000, step=1000)
            dti = st.slider("Debt-to-Income Ratio", 0.05, 0.95, 0.35)
            obligations = st.number_input("Existing Credit Obligations (ZAR)", min_value=0, value=5000, step=500)
            repayment = st.slider("Repayment History Score (0=poor, 1=excellent)", 0.0, 1.0, 0.75)
        with col2:
            utilisation = st.slider("Credit Utilisation Rate", 0.0, 1.0, 0.30)
            loan_amount = st.number_input("Loan Amount (ZAR)", min_value=1000, value=100000, step=5000)
            duration = st.selectbox("Loan Duration (months)", [6, 12, 18, 24, 36, 48, 60], index=3)
            employment = st.selectbox("Employment Status", ["Employed", "Self-Employed", "Unemployed"])

        submitted = st.form_submit_button("Assess Application")

    if submitted:
        payload = {
            "monthly_income_zar": income,
            "debt_to_income_ratio": dti,
            "existing_credit_obligations_zar": obligations,
            "repayment_history_score": repayment,
            "credit_utilisation_rate": utilisation,
            "loan_amount_zar": loan_amount,
            "loan_duration_months": duration,
            "employment_status": employment,
            "model_name": "xgboost",
        }
        try:
            r = requests.post("http://localhost:8000/predict", json=payload)
            result = r.json()
            st.success(f"Application ID: {result['application_id']}")
            st.metric("Predicted Default Probability", f"{result['prediction']['default_probability']:.2%}")
            st.metric("Illustrative Decision", result['prediction']['illustrative_decision'])

            st.subheader("Plain-Language Explanation")
            st.write(result["plain_language"]["plain_language"])
            st.caption(result["plain_language"]["limitations"])

            st.subheader("Top Contributing Factors (SHAP)")
            factors_df = pd.DataFrame(result["explanation"]["top_factors"])
            fig = px.bar(factors_df, x="shap_value", y="friendly_name", orientation="h",
                         color="shap_value", color_continuous_scale="RdBu")
            st.plotly_chart(fig, use_container_width=True)

            if result["counterfactual"]["counterfactual"]:
                st.subheader("Counterfactual Scenario")
                st.json(result["counterfactual"])

            if result["review_required"]:
                st.warning("⚠️ This decision has been flagged for manual review.")
        except Exception as e:
            st.error(f"API error: {e}. Ensure FastAPI is running on port 8000.")


# =========================================================
# PAGE 3: Fairness & Bias Dashboard
# =========================================================
elif page == "Fairness & Bias Dashboard":
    st.title("⚖️ Fairness & Bias Dashboard")
    audit = run_full_audit()

    attr = st.selectbox("Protected Attribute", list(audit.keys()))
    data = audit[attr]

    col1, col2, col3 = st.columns(3)
    col1.metric("Demographic Parity Diff", data["demographic_parity_difference"])
    col2.metric("Equalized Odds Diff", data["equalized_odds_difference"])
    col3.metric("Disparate Impact Ratio", data["disparate_impact_ratio"])

    group_df = pd.DataFrame(data["group_metrics"])
    fig = px.bar(group_df, x="group", y="selection_rate", title="Selection Rate by Group")
    st.plotly_chart(fig, use_container_width=True)

    fig2 = px.bar(group_df.melt(id_vars="group", value_vars=["fpr", "fnr"]),
                  x="group", y="value", color="variable", barmode="group",
                  title="False Positive / False Negative Rates")
    st.plotly_chart(fig2, use_container_width=True)

    st.warning(
        "**Interpretation caution:** Group differences do not automatically establish "
        "unlawful discrimination. The synthetic data contains structural inequalities. "
        "The disparate impact ratio (min/max selection rate) is a diagnostic indicator, "
        "not a legal test under South African law."
    )


# =========================================================
# PAGE 4: Model Explainability
# =========================================================
elif page == "Model Explainability":
    st.title("🔍 Model Explainability")
    importance = get_global_importance("xgboost")
    st.subheader("Global Feature Importance (Mean |SHAP|)")
    imp_df = pd.DataFrame(importance)
    fig = px.bar(imp_df, x="mean_abs_shap", y="friendly_name", orientation="h")
    st.plotly_chart(fig, use_container_width=True)

    st.info(
        "SHAP values show how each feature contributes to the model's prediction "
        "relative to the baseline. They indicate statistical association, not causation."
    )


# =========================================================
# PAGE 5: Accountability & Audit
# =========================================================
elif page == "Accountability & Audit":
    st.title("🔗 Accountability & Audit Trail")
    verification = verify_chain()
    if verification["valid"]:
        st.success(f"Audit chain intact. {verification['records']} records verified.")
    else:
        st.error(f"Chain integrity failure at record {verification.get('broken_at_id')}.")

    records = get_all_records()
    if records:
        df = pd.DataFrame(records)[[
            "id", "application_id", "model_name", "timestamp", "decision",
            "human_reviewer", "override_flag", "record_hash"
        ]]
        st.dataframe(df, use_container_width=True)
    else:
        st.info("No audit records yet.")


# =========================================================
# PAGE 6: Regulatory Governance
# =========================================================
elif page == "Regulatory Governance":
    st.title("🏛️ Regulatory Governance Dashboard")
    gov = get_governance_summary()

    col1, col2, col3 = st.columns(3)
    col1.metric("Compliant Controls", gov["compliant"])
    col2.metric("Partially Implemented", gov["partially_implemented"])
    col3.metric("Gaps Identified", gov["gaps"])

    st.dataframe(pd.DataFrame(gov["controls"])[[
        "id", "domain", "control", "status", "risk", "action"
    ]], use_container_width=True)

    st.warning(gov["disclaimer"])
